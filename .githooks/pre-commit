#!/bin/sh
root=$(git rev-parse --show-toplevel) || exit 1
if command -v python >/dev/null 2>&1; then
    exec python "$root/.githooks/check_local_privacy.py"
fi
if command -v py >/dev/null 2>&1; then
    exec py -3 "$root/.githooks/check_local_privacy.py"
fi
echo "privacy-check: Python 3 is required" >&2
exit 1
